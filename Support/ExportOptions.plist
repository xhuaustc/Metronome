	<string>manual</string>
	<key>teamID</key>
	<string>3BVFM34328</string>
	<key>signingCertificate</key>
	<string>iPhone Distribution: Xiaohua Pan (3BVFM34328)</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.mpan.pianometronome</key>
		<string>PianoMetronome AppStore</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
